{
  "name": "pr-review-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run server/index.ts",
    "dev": "bunx --bun vite build --watch",
    "build": "bun run typecheck && bunx --bun vite build",
    "typecheck": "tsc -b --noEmit",
    "check:format": "biome format",
    "check:lint": "biome lint",
    "reformat": "biome format --write",
    "lint": "biome lint --fix",
    "test": "bun test",
    "palettes": "bun scripts/palettes.mjs && biome check --write src/styles/palettes.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tiptap/extensions": "3.32.1",
    "@tiptap/markdown": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.17",
    "ky": "^2.2.0",
    "lucide-react": "^1.63.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
